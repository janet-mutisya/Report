########################################
# SERVER CONFIGURATION
########################################
PORT=5000
NODE_ENV=production
TIMEZONE=Africa/Nairobi

# 🔧 LOGGING CONFIGURATION
LOG_LEVEL=info          # Options: error, warn, info, debug, trace
LOG_TO_FILE=false       # Set to true to enable file logging
LOG_FILE_PATH=app.log   # Path for log file (if enabled)

HOST=0.0.0.0
SERVER_TIMEOUT=120000
ALLOW_HTTP_1=true

########################################
# DATABASE (MSSQL) - OPTIMIZED
########################################
USE_DATABASE=true
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=your_secure_password_here
DB_DATABASE=_Datos
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=15000
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_ACQUIRE_TIMEOUT=30000
DB_MAX_RETRIES_ON_DEADLOCK=2
DB_LOG_PARAMETERS=false

########################################
# AUTHENTICATION & SECURITY
########################################
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-this-to-another-secure-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
ENABLE_HTTP2=false

########################################
# EMAIL CONFIGURATION - OPTIMIZED
########################################
ENABLE_EMAIL_SENDING=false
EMAIL_SERVICE=office365
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM=your-email@example.com
EMAIL_FROM_NAME=BM Security Reports
EMAIL_CONNECTION_TIMEOUT=10000
EMAIL_GREETING_TIMEOUT=5000
EMAIL_SEND_TIMEOUT=15000
EMAIL_RETRY_ATTEMPTS=2
EMAIL_RETRY_DELAY=2000
EMAIL_LOG_CONNECTIONS=false
EMAIL_VALIDATE_RECIPIENTS=false

# Test/Debug Settings
TEST_EMAIL=test@example.com
TEST_MODE=false
EMAIL_LOGGING_ENABLED=true
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_MAX_SIZE=100
EMAIL_QUEUE_PROCESS_INTERVAL=30000
EMAIL_QUEUE_CONCURRENCY=3

########################################
# BM SECURITY API INTEGRATION - ULTRA OPTIMIZED
########################################
USE_BMSECURITY_API=true
USE_API=true
USE_API_AS_PRIMARY=true
FALLBACK_TO_DB=false
FORCE_API_FETCH=true

# API Credentials
BMSECURITY_API_URL=https://bmsecurity.ultrasecuritysolution.com
BM_API_USER=your-api-username
BM_API_PASSWORD=your-api-password
BM_API_CLIENT_ID=your-client-id

# ⚡ API PERFORMANCE OPTIMIZATIONS ⚡
API_REQUEST_TIMEOUT=300000
API_LOGIN_TIMEOUT=30000
API_MAX_RETRIES=2
API_PARALLEL_CHUNKS=10
API_REQUEST_DELAY=100
API_MAX_PAGES_PER_CHUNK=10
API_PAGE_SIZE=20000
API_DEDUP_THRESHOLD=20
API_CHUNK_SIZE_DAYS=14
API_CONNECTION_TIMEOUT=10000
API_RESPONSE_TIMEOUT=290000
API_KEEPALIVE_TIMEOUT=5000
API_SOCKET_TIMEOUT=120000

# 🔥 API CACHE SETTINGS 🔥
API_RAW_CACHE_TTL=1800000
API_ACCOUNT_CACHE_TTL=3600000
API_DAILY_SUMMARY_CACHE_TTL=7200000
API_MAX_CACHE_ENTRIES=1000
API_CACHE_CLEAN_INTERVAL=300000
API_CACHE_COMPRESSION=true

# ⚡ API PERFORMANCE FLAGS ⚡
API_SKIP_VALIDATION_FOR_CACHED=true
API_COMPRESS_RESPONSE=true
API_MAX_EVENTS_PER_REQUEST=100000
API_USE_STREAMING_PARSER=true
API_DISABLE_DEBUG_LOGGING=true
API_SKIP_MALFORMED_CHECK=false
API_FAST_DEDUPE_ONLY=true
API_SKIP_TIMESTAMP_PARSING=false
API_MINIMAL_FIELD_VALIDATION=true
API_DISABLE_STATS_COLLECTION=true
API_USE_BINARY_SEARCH=true
API_PREFETCH_ENABLED=true
API_PREFETCH_DAYS=2
API_LAZY_LOADING=true
API_CONCURRENT_LOGIN=true
API_BATCH_TOKEN_REFRESH=true
API_TOKEN_CACHE_TTL=300000
API_SESSION_PERSISTENCE=true
API_AGGRESSIVE_DEDUPLICATION=true
API_SMART_DATE_RANGE_DETECTION=true
API_USE_WORKER_THREADS=false
API_MAX_WORKERS=4

########################################
# PDF GENERATION & REPORTING - OPTIMIZED & FIXED
########################################
# 🔧 PDF STORAGE CONFIGURATION
# CRITICAL: Leave REPORTS_OUTPUT_DIR empty to use system temp directory (RECOMMENDED)
# This prevents "can't write to packaged folders" errors on the server
# 
# Windows temp location: C:\Users\[Username]\AppData\Local\Temp\guard-reports\
# Linux temp location: /tmp/guard-reports/
#
# Or specify a custom writable path (ensure the application has write permissions):
# Windows example: REPORTS_OUTPUT_DIR=C:\GuardReports
# Linux example: REPORTS_OUTPUT_DIR=/var/lib/guard-reports
#
REPORTS_OUTPUT_DIR=

# PDF Generation Settings
MAX_CONCURRENT_PDFS=5
PDF_GENERATION_TIMEOUT=90000
PDF_QUEUE_SIZE=20
PDF_RETRY_ATTEMPTS=2
PDF_CHUNK_SIZE=500
PDF_COMPRESSION_LEVEL=6
PDF_MEMORY_LIMIT_MB=512
PDF_FONT_SUBSETTING=true
PDF_IMAGE_QUALITY=80

# PDF Cleanup Settings
# Automatically clean up old temporary PDF files to prevent disk space issues
PDF_CLEANUP_ENABLED=true
PDF_CLEANUP_AGE_HOURS=24        # Delete PDFs older than 24 hours
PDF_CLEANUP_INTERVAL_HOURS=6    # Run cleanup every 6 hours

# Legacy Settings (Deprecated - kept for backward compatibility)
SAVE_PDF_TO_DISK=false
PDF_STORAGE_PATH=./storage/pdfs
PDF_CLEANUP_DAYS=7

########################################
# SCHEDULER & BACKGROUND JOBS - ENHANCED
########################################
ENABLE_SCHEDULER=true
SCHEDULER_CHECK_INTERVAL=* * * * *
GRACE_PERIOD_MINUTES_PAST=60
GRACE_PERIOD_MINUTES_FUTURE=5
DELAY_BETWEEN_CLIENTS=500
MAX_CONCURRENT_SCHEDULES=3
SCHEDULER_TIMEOUT=300000

# Scheduler Interval (milliseconds)
# Default: 600000 (10 minutes for production), 300000 (5 minutes for development)
# Examples: 300000 = 5 min, 600000 = 10 min, 1800000 = 30 min
SCHEDULER_INTERVAL=600000

# Cron Pattern (optional - overrides SCHEDULER_INTERVAL if set)
# Leave empty to use SCHEDULER_INTERVAL instead
# Examples: 
#   */5 * * * *  = Every 5 minutes
#   */10 * * * * = Every 10 minutes
#   0 */1 * * *  = Every hour at minute 0
#   0 0 * * *    = Daily at midnight
#   0 9,17 * * * = Daily at 9 AM and 5 PM
SCHEDULER_CRON_PATTERN=

# Catchup Mode Settings
ENABLE_CATCHUP_MODE=true
CATCHUP_MAX_MINUTES_BACK=240
CATCHUP_MAX_SCHEDULES_PER_RUN=20
CATCHUP_RETRY_ATTEMPTS=1

# Background Cache Refresh
BACKGROUND_REFRESH_ENABLED=true
BACKGROUND_REFRESH_INTERVAL=3600000
BACKGROUND_MAX_CONCURRENT=2
BACKGROUND_PRIORITY_LOW_THRESHOLD=5

########################################
# APPLICATION FEATURES & FLAGS
########################################
ENABLE_BACKUP_SYNC=false
SYNC_BATCH_SIZE=10000
SYNC_TIMEOUT=240000
REALTIME_UPDATES_ENABLED=false
REALTIME_UPDATE_INTERVAL=60000
NOTIFICATIONS_ENABLED=true
NOTIFICATION_WEBHOOK_URL=
ALERT_THRESHOLD_PERCENT=15
DATA_VALIDATION_ENABLED=true
ENABLE_ANALYTICS=true
ANALYTICS_SAMPLE_RATE=0.1
ENABLE_TELEMETRY=false

########################################
# MONITORING & LOGGING
########################################
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=300000
HEALTH_TIMEOUT=5000
METRICS_ENABLED=true
METRICS_PORT=9090
REQUEST_LOGGING_ENABLED=true
SLOW_REQUEST_THRESHOLD=5000
ERROR_TRACKING_ENABLED=true
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.05
LOG_REQUESTS_TO_FILE=false
LOG_ERRORS_TO_FILE=true
ERROR_LOG_FILE=scheduler_errors.log
SUCCESS_LOG_FILE=scheduler_success.log

########################################
# CACHE & PERFORMANCE - OPTIMIZED
########################################
RAW_CACHE_TTL=300000
PROCESSED_CACHE_TTL=300000
MEMORY_CACHE_ENABLED=true
MEMORY_CACHE_MAX_SIZE=2000
MEMORY_CACHE_TTL=1800000
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=3
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=120000
COMPRESSION_ENABLED=true
GZIP_THRESHOLD=1024
BROTLI_ENABLED=false

# Network & Connection Optimizations
HTTP_KEEP_ALIVE=true
HTTP_KEEP_ALIVE_MS=65000
MAX_SOCKETS=100
MAX_FREE_SOCKETS=20
CONNECTION_POOL_SIZE=25
SOCKET_TIMEOUT=120000
ENABLE_CONNECTION_REUSE=true
TCP_KEEPALIVE=true
TCP_KEEPALIVE_INTERVAL=30000

# Memory & Processing Optimizations
OPTIMIZE_MEMORY_ALLOCATION=true
REDUCE_GC_PRESSURE=true
BATCH_PROCESSING_SIZE=2000
STREAM_PROCESSING_ENABLED=true
ENABLE_BUFFER_POOLING=true
BUFFER_POOL_SIZE=10
MAX_EVENT_LOOP_DELAY_MS=100
MAX_HEAP_USED_PERCENT=80
MAX_RSS_MB=1024

# Application Performance
ENABLE_RESPONSE_CACHING=true
RESPONSE_CACHE_TTL=30000
ENABLE_REQUEST_DEDUPLICATION=true
REQUEST_DEDUPE_WINDOW_MS=1000
ENABLE_LAZY_LOADING=true
LAZY_LOADING_THRESHOLD=1000
ENABLE_PRELOADING=false
PRELOAD_CACHE_SIZE=50

########################################
# DEBUG & DEVELOPMENT
########################################
DEBUG_MODE=false
DEBUG_API_REQUESTS=false
DEBUG_CACHE=false
DEBUG_EMAIL=false
DEBUG_SCHEDULER=false
DEBUG_PDF=false
VERBOSE_LOGGING=false
ENABLE_SWAGGER=false
SWAGGER_PATH=/api-docs
ALLOW_SELF_SIGNED_CERTS=false
ENABLE_PROFILING=false
PROFILING_SAMPLE_RATE=0.01

########################################
# FILE SYSTEM & STORAGE
########################################
MAX_UPLOAD_SIZE_MB=50
MAX_BODY_SIZE_MB=10
TEMP_DIRECTORY=./temp
MAX_TEMP_FILES=100
TEMP_FILE_CLEANUP_INTERVAL=3600000
ENABLE_FILE_STREAMING=true
FILE_STREAM_CHUNK_SIZE=65536

########################################
# SECURITY HEADERS
########################################
ENABLE_SECURITY_HEADERS=true
ENABLE_CSP=false
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
ENABLE_XSS_PROTECTION=true
ENABLE_NOSNIFF=true
ENABLE_FRAMEGUARD=true
FRAMEGUARD_ACTION=SAMEORIGIN

########################################
# ERROR HANDLING & RESILIENCE
########################################
MAX_ERROR_RATE_PERCENT=5
ERROR_RATE_WINDOW_MS=60000
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=50
CIRCUIT_BREAKER_WINDOW_MS=30000
CIRCUIT_BREAKER_TIMEOUT_MS=60000
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000
RETRY_MAX_ATTEMPTS=3
RETRY_JITTER=true

########################################
# SCHEDULER-SPECIFIC SETTINGS
########################################
SCHEDULER_MAX_RUNTIME_MS=600000
SCHEDULER_HEARTBEAT_INTERVAL_MS=30000
SCHEDULER_RECOVERY_MODE=true
SCHEDULER_RECOVERY_MAX_AGE_MINUTES=480
SCHEDULER_SKIP_DUPLICATE_MINUTES=10
SCHEDULER_FORCE_UPDATE_ON_FAILURE=true
SCHEDULER_VERIFY_UPDATES=true
SCHEDULER_LOG_DETAILED_STATS=true
SCHEDULER_STATS_RETENTION_DAYS=30

########################################
# 📝 CONFIGURATION NOTES
########################################
# 
# FOR SERVER DEPLOYMENT:
# 1. Update all credentials (DB, API, Email)
# 2. Set NODE_ENV=production
# 3. Leave REPORTS_OUTPUT_DIR empty to use temp directory
# 4. Set ENABLE_EMAIL_SENDING=true to enable reports
# 5. Adjust SCHEDULER_INTERVAL based on your needs
#
# TROUBLESHOOTING PDF ISSUES:
# - If you see "can't write to packaged folders" error:
#   → Leave REPORTS_OUTPUT_DIR empty (uses system temp)
# - If you want custom location:
#   → Set REPORTS_OUTPUT_DIR=C:\GuardReports
#   → Ensure the folder exists and is writable
# - Old PDFs are auto-cleaned after 24 hours by default
#
# SCHEDULER CONFIGURATION:
# - Use SCHEDULER_INTERVAL for simple intervals (milliseconds)
# - Use SCHEDULER_CRON_PATTERN for complex schedules
# - CRON pattern overrides INTERVAL if both are set
#
########################################