{
  "name": "guard-report-server",
  "version": "3.0.0",
  "description": "BM Security Guard Reports Backend with React Frontend - Auto-Browser Opening Included",
  "private": true,
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:frontend": "cd ../client/reports && npm run build",
    "clean": "node -e \"const fs=require('fs');if(fs.existsSync('release'))fs.rmSync('release',{recursive:true,force:true});if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true,force:true});\"",
    "build": "node build.js",
    "build:automated": "node build-exe.js",
    "build:pkg:win": "pkg . --targets node18-win-x64 --output release/guard-report-server.exe --compress GZip",
    "build:pkg:linux": "pkg . --targets node18-linux-x64 --output release/guard-report-server-linux --compress GZip",
    "build:pkg:mac": "pkg . --targets node18-macos-x64 --output release/guard-report-server-macos --compress GZip",
    "package": "pnpm run clean && pnpm run build:pkg:win",
    "release": "pnpm run build:frontend && pnpm run package",
    "verify": "node -e \"console.log('Node version:', process.version); console.log('Platform:', process.platform);\"",
    "size": "node -e \"const fs=require('fs');const files=fs.readdirSync('release');files.forEach(f=>{const s=fs.statSync('release/'+f);console.log(f,':',(s.size/1024/1024).toFixed(2),'MB')});\""
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.1.0",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "open": "^11.0.0",
    "p-limit": "^7.2.0",
    "pdfkit": "^0.17.2",
    "stream-buffers": "^3.0.3",
    "tedious": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "config/**/*",
      "routes/**/*",
      "service/**/*",
      "models/**/*",
      "middleware/**/*",
      "controllers/**/*",
      "utils/**/*",
      "data/**/*",
      "dist/**/*",
      "../client/reports/dist/**/*",
      ".env",
      ".env.example",
      "logger.js",
      "node_modules/pdfkit/js/data/**/*",
      "node_modules/pdfkit/js/afm/**/*",
      "node_modules/fontkit/**/*",
      "node_modules/linebreak/**/*",
      "node_modules/png-js/**/*"
    ],
    "scripts": [
      "config/**/*.js",
      "routes/**/*.js",
      "service/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "controllers/**/*.js",
      "utils/**/*.js"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ],
    "outputPath": "release"
  },
  "config": {
    "port": 5000,
    "autoBrowserDelay": 1500,
    "asciiFix": true
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64"
  ],
  "author": "BM Security",
  "license": "MIT"
}
