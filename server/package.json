{
  "name": "guard-report-server",
  "version": "1.0.0",
  "description": "BM Security Reports Backend",
  "private": true,
  "type": "module",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:frontend": "pnpm --dir ../client/reports run build",
    "build:exe": "pnpm run build:frontend && pkg .",
    "build:exe:windows": "pnpm run build:frontend && pkg . --targets node18-win-x64 --output release/guard-report-windows.exe",
    "build:exe:linux": "pnpm run build:frontend && pkg . --targets node18-linux-x64 --output release/guard-report-linux",
    "build:exe:all": "pnpm run build:frontend && pkg . --targets node18-win-x64,node18-linux-x64"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.9",
    "p-limit": "^7.2.0",
    "pdfkit": "^0.17.2",
    "stream-buffers": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "../client/reports/dist/**/*",
      "node_modules/mssql/**/*",
      "node_modules/mysql2/**/*",
      "node_modules/bcrypt/**/*"
    ],
    "scripts": [
      "server.js",
      "routes/**/*.js",
      "models/**/*.js",
      "service/**/*.js",
      "utils/**/*.js",
      "middleware/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "release"
  },
  "engines": {
    "node": ">=18"
  }
}
